# Database
DATABASE_URL=postgresql+asyncpg://agent_reviewer:secure_password_change_me@localhost:5432/agent_reviewer

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Providers (al menos uno requerido)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# GitHub App Configuration
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# n8n Integration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/github

# Notifications
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development
SECRET_KEY=your_secret_key_change_in_production
API_V1_STR=/api/v1
PROJECT_NAME=Agent Reviewer

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Analysis Settings
MAX_FILE_SIZE_MB=10
MAX_REPO_SIZE_MB=500
ANALYSIS_TIMEOUT_SECONDS=300
MAX_CONCURRENT_ANALYSES=5